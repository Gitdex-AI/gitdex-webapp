# Local-only values. Never commit the real .env.

# Database password of the Supabase project (used by `supabase link` / `supabase db push`).
SUPABASE_DB_PASSWORD=

# Shared secret between the Cloudflare worker and the Supabase `api` function.
# Set the same value in both places:
#   supabase secrets set GITDEX_PROXY_SECRET=...
#   wrangler secret put GITDEX_PROXY_SECRET --config web/wrangler.jsonc
GITDEX_PROXY_SECRET=

# Social sign-in (only needed when enabling the providers in supabase/config.toml).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
